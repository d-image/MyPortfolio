APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_FORCE_HTTPS=false
APP_MAX_REQUEST_SIZE=1048576
APP_CONTACT_RATE_LIMIT=5
APP_CONTACT_RATE_WINDOW_SECONDS=300
APP_AUTH_RATE_LIMIT=10
APP_AUTH_RATE_WINDOW_SECONDS=900
APP_SUBMISSIONS_FILE=backend/runtime/contact_submissions.jsonl
APP_AUTH_DATABASE_FILE=backend/runtime/blog_auth.sqlite3
